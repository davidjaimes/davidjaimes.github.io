---
import LayoutBase from "../layouts/LayoutBase.astro";
import "../styles/global.css";
---

<LayoutBase>
    <section
        class="max-w-4xl mx-auto pt-4 laptop:pt-8 font-mono text-gray-dark px-4"
    >
        <h2 class="pb-4 text-4xl text-center">404 Error</h2>
        <h1 class="pb-8 text-2xl text-center">Page Not Found</h1>
        <p class="text-center">
            It looks like you've found a URL that does not exist. Please use the
            navigation above to find your way back to my main page.
        </p>
    </section>
</LayoutBase>
