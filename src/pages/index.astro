---
import LayoutBase from "../layouts/LayoutBase.astro";
import Jumbotron from "../components/Jumbotron.astro";
import "../styles/global.css";
---

<LayoutBase>
    <Jumbotron />
    <div
        class="max-w-4xl mx-auto pt-8 laptop:pt-12 font-mono text-gray-dark px-4;"
    >
        <p class="p-4 text-gray-dark">
            I enjoy astronomy/astrophysics, trail running, bicycling, fine
            dinning, web design, code programming, data visualization, and
            reading in my free time.
        </p>
    </div>
</LayoutBase>
